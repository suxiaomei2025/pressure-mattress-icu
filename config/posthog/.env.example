# Copy to .env and fill in strong secrets. NEVER commit real values.
POSTHOG_SECRET=change…-min
POSTHOG_DB_NAME=posthog
POSTHOG_DB_USER=posthog
POSTHOG_DB_PASSWORD=***
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=***

# Client-side (telemetry SDK) settings — served server-side, never in the web bundle:
# TELEMETRY_ENDPOINT=https://analytics.example.com
# TELEMETRY_API_KEY=*** ingest key (write-only)>
# TELEMETRY_SALT=<rotating HMAC salt>
