# =============================================================================
# PressureMattress ICU - environment configuration
# Copy to .env for docker-compose, or use these keys in the Helm values file.
# NEVER commit a real .env with production secrets.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=pressure_mattress
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pressure_mattress
POSTGRES_PORT=5432

# --- API service ---
API_PORT=8080
API_LOG_LEVEL=info
NODE_ENV=production

# Full connection string used by the API container (compose service name "db").
DATABASE_URL=postgres://pressure_mattress:change-me-strong-password@db:5432/pressure_mattress

# --- Dashboard ---
# Host port the dashboard (nginx) is published on in docker-compose.
DASHBOARD_PORT=8081

# --- Backup (used by scripts/backup.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
